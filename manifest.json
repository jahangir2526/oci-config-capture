{
  "manifest_version": 3,
  "name": "OCI Config Capture",
  "description": "Displays tenancy, user, region, and compartments from the active OCI Console session.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OCI Config Capture"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.oraclecloud.com/*",
    "https://*.oci.oraclecloud.com/*",
    "https://*.oracle.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/page-probe.js"],
      "matches": [
        "https://*.oraclecloud.com/*",
        "https://*.oci.oraclecloud.com/*",
        "https://*.oracle.com/*"
      ]
    }
  ]
}
